{
  "name": "@fungi.computer/whistle",
  "version": "0.1.0",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Semantic command graph, projections and wire parsing",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "import": "./dist/interaction.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src test --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "docs": "tsx ../../tooling/repository/src/docs/cli.ts check --root ../..",
    "docs:write": "tsx ../../tooling/repository/src/docs/cli.ts write --root ../..",
    "pack": "mkdir -p ../../.botanical/whistle-pack && pnpm pack --pack-destination ../../.botanical/whistle-pack",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(({ createWhistle }) => { if (typeof createWhistle !== 'function') process.exit(1); })\"",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs",
    "test:html": "node test/html.browser.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@opentui/keymap": "0.5.10",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@opentui/keymap": "0.5.10"
  },
  "peerDependenciesMeta": {
    "@opentui/keymap": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/whistle.git"
  }
}
